FROM python:3.11-slim

WORKDIR /app

# Install nano for the interactive setlist editor
RUN apt-get update && apt-get install -y \
    nano \
    && rm -rf /var/lib/apt/lists/*

# Install only the light dependencies needed for the CLI
RUN pip install --no-cache-dir psycopg2-binary python-dotenv

COPY . .

ENTRYPOINT ["python", "cli_program/setlistcli.py"]
